{
  "name": "india_api",
  "version": "1.0.0",
  "description": "REST API for India's geographic hierarchy — states, districts, subdistricts, and 5.8 lakh+ villages — with fuzzy trigram autocomplete. Built on Node/Express + PostgreSQL (Neon).",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test server.test.js",
    "seed": "node seed.js final_india_villages.csv",
    "migrate": "node -r dotenv/config node_modules/node-pg-migrate/bin/node-pg-migrate.js",
    "migrate:up": "node -r dotenv/config node_modules/node-pg-migrate/bin/node-pg-migrate.js up",
    "migrate:down": "node -r dotenv/config node_modules/node-pg-migrate/bin/node-pg-migrate.js down",
    "test:security": "node --import ./test/genai-mock-hook-register.mjs --test adversarial.test.js",
    "test:multilingual": "node --test multilingual.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google/genai": "^2.8.0",
    "@indic-transliteration/sanscript": "^1.3.3",
    "@sentry/node": "^10.58.0",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "node-cache": "^5.1.2",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "node-pg-migrate": "^9.0.0",
    "supertest": "^7.2.2"
  }
}
